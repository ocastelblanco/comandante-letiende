rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones de ayuda ──────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isRootAdmin() {
      return isAuthenticated()
          && request.auth.token.email == 'letiende.co@gmail.com';
    }

    // Retorna el rol del usuario autenticado, o null si no existe su documento.
    // El documento usa el email como ID (no el UID), igual que UserService.createUser().
    // Nota: se usa operador ternario para retornar el string del rol directamente;
    // el operador && en Firestore rules retorna bool, no el último valor.
    function userRole() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
          ? get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role
          : null;
    }

    function isAdmin() {
      return isRootAdmin() || userRole() == 'admin';
    }

    function isWaiter() {
      return userRole() == 'waiter';
    }

    function isBarista() {
      return userRole() == 'barista';
    }

    // Subcategorías válidas para cada categoría raíz de producto.
    // 'comida' y 'reposteria' no tienen subcategorías (lista vacía).
    function productSubcategoriesFor(category) {
      return category == 'bebidas' ? ['de_cafe', 'calientes', 'frias']
          : category == 'cocteles' ? ['clasicos', 'de_autor', 'premium']
          : category == 'licores' ? ['trago', 'botella']
          : category == 'cervezas' ? ['nacionales', 'importadas', 'artesanales']
          : category == 'ofertas' ? ['combos', 'promociones']
          : [];
    }

    // Valida que `category` sea una de las 7 categorías raíz permitidas y que
    // `subcategory` sea una combinación válida para esa categoría: ausente o
    // null si la categoría no tiene subcategorías, o un valor exacto de su
    // lista si sí las tiene. También exige `basePrice` numérico no negativo
    // (la propina ya no vive en el producto desde la Tarea 29) y que
    // `variants`/`additions` sean listas.
    // `data` es siempre el documento resultante completo (Firestore fusiona
    // las escrituras parciales antes de evaluar las reglas), así que esto
    // también protege `archiveProduct()`/`toggleActive()`, que solo envían
    // `isActive` — los demás campos ya existen en el documento previo.
    function isValidProductData(data) {
      let category = data.category;
      let allowedSubcategories = productSubcategoriesFor(category);
      return category in ['bebidas', 'cocteles', 'licores', 'cervezas', 'comida', 'reposteria', 'ofertas']
          && (
            allowedSubcategories.size() == 0
              ? (!('subcategory' in data) || data.subcategory == null)
              : (('subcategory' in data) && data.subcategory in allowedSubcategories)
          )
          && data.basePrice is number && data.basePrice >= 0
          && data.variants is list
          && data.additions is list;
    }

    // Los baristas solo pueden tocar campos de estado al actualizar un pedido.
    // 'items' se incluye para que puedan marcar itemStatus de cada ítem como 'ready'.
    function onlyUpdatesOrderStatus() {
      let allowed = ['status', 'updatedAt', 'baristaId', 'preparedAt', 'items'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Los meseros solo pueden marcar un pedido como 'delivered' (entregado), y solo una vez:
    // 'deliveredAt' (Tarea 37) es la marca de tiempo de esa transición, no se reescribe.
    function onlyMarksDelivered() {
      let allowed = ['status', 'updatedAt', 'deliveredAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed)
          && resource.data.status != 'delivered'
          && request.resource.data.status == 'delivered';
    }

    // Los meseros solo pueden marcar un pedido como pagado (false → true).
    function onlyMarksPaid() {
      let allowed = ['paid', 'paidAt', 'paymentMethod', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed)
          && resource.data.paid == false
          && request.resource.data.paid == true;
    }

    // Los meseros pueden editar la propina de un pedido mientras no esté pagado.
    function onlyUpdatesTip() {
      let allowed = ['tipPercentage', 'tipValue', 'tipAmount', 'total', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed)
          && resource.data.paid == false;
    }

    // ── Colección: users ────────────────────────────────────────────────────
    // Lectura para cualquier usuario autenticado.
    // Escrituras (alta, modificación y baja) solo para administradores.
    // Prohibido que un no-administrador altere su propio campo `role`.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── Colección: products ─────────────────────────────────────────────────
    // Lectura para cualquier usuario autenticado.
    // Escrituras solo para administradores.
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidProductData(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── Colección: orders ───────────────────────────────────────────────────
    // Mesero: leer y crear pedidos.
    // Barista: leer y actualizar únicamente campos de estado.
    // Administrador: acceso total.
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create: if isWaiter() || isAdmin();
      allow update: if isAdmin()
          || (isBarista() && onlyUpdatesOrderStatus())
          || (isWaiter() && (onlyMarksDelivered() || onlyMarksPaid() || onlyUpdatesTip()));
      allow delete: if isAdmin();
    }
  }
}
